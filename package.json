{
  "name": "rembert.dev",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "next dev",
    "dev:test": "bun run --cwd apps/test dev",
    "dev:proxy": "microfrontends proxy microfrontends.json --local-apps rembert.dev rembert-test",
    "build": "next build",
    "start": "next start",
    "test": "bun test",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/microfrontends": "^2.3.6",
    "next": "16.3.8",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "26.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.2"
  },
  "packageManager": "bun@1.3.11",
  "trustedDependencies": [],
  "overrides": {
    "baseline-browser-mapping": "2.11.29",
    "fast-uri": "3.1.8",
    "nanoid": "3.3.20",
    "source-map-js": "1.2.2"
  }
}
